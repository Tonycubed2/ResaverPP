# Builds LangEmbedded.cpp: the interface translations lang/<code>.txt as byte arrays, so the exe carries them.
# cmake -DLANG_DIR=<repo>/lang -DOUT=<file.cpp> -P EmbedLang.cmake
file(GLOB files "${LANG_DIR}/*.txt")
list(SORT files)
set(out "// Generated by cmake/EmbedLang.cmake from lang/*.txt. Do not edit: edit lang/<code>.txt.\n#include \"core/Lang.h\"\n\nnamespace i18n\n{\n\tnamespace\n\t{\n")
set(table "")
set(i 0)
foreach(f ${files})
	get_filename_component(code "${f}" NAME_WE)
	file(READ "${f}" hex HEX)
	string(LENGTH "${hex}" n)
	math(EXPR bytes "${n} / 2")
	string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
	string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],))" "\\1\n" hex "${hex}")
	string(APPEND out "\t\tconst unsigned char k${i}[] = {\n${hex}0 };\n")
	string(APPEND table "\t\t\t{ \"${code}\", k${i}, ${bytes} },\n")
	math(EXPR i "${i} + 1")
endforeach()
string(APPEND out "\t}\n\n\tconst std::vector<Builtin>& Builtins()\n\t{\n\t\tstatic const std::vector<Builtin> v = {\n${table}\t\t};\n\t\treturn v;\n\t}\n}\n")
file(WRITE "${OUT}.tmp" "${out}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
