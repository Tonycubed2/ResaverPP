# CLI test: resaverpp-cli --fo4-effects / --fo4-remove-effects (ctest cli_fo4_effects).
# cmake -DCLI=<resaverpp-cli> -DOUT=<work dir> -P cli_fo4_effects.cmake
# Real saves from RESAVERPP_FO4_SAVES="dir;dir": on each, the player's effects are listed, the first one whose removal
# changes no stat is removed into a new save (the CLI reads it back itself), and the new save must list one effect less.
# Without saves only the argument checks run and the test says "skipped".
if (NOT CLI OR NOT OUT)
	message(FATAL_ERROR "needs -DCLI and -DOUT")
endif()
file(MAKE_DIRECTORY "${OUT}")

# argument checks (no save needed: they fail before the save is read)
execute_process(COMMAND "${CLI}" nothing.fos --fo4-remove-effects player RESULT_VARIABLE r ERROR_VARIABLE e OUTPUT_QUIET)
if (r EQUAL 0 OR NOT e MATCHES "needs <actor>:")
	message(FATAL_ERROR "--fo4-remove-effects without <what> was accepted: ${r} ${e}")
endif()
execute_process(COMMAND "${CLI}" nothing.fos --fo4-remove-effects player:all RESULT_VARIABLE r ERROR_VARIABLE e OUTPUT_QUIET)
if (r EQUAL 0 OR NOT e MATCHES "needs -o")
	message(FATAL_ERROR "--fo4-remove-effects without -o was accepted: ${r} ${e}")
endif()

set(saves "")
foreach (dir $ENV{RESAVERPP_FO4_SAVES})
	file(GLOB_RECURSE found "${dir}/*.fos")
	list(APPEND saves ${found})
endforeach()
if (NOT saves)
	message("fo4 effects CLI: RESAVERPP_FO4_SAVES not set, real saves skipped")
	return()
endif()

set(done 0)
foreach (save ${saves})
	execute_process(COMMAND "${CLI}" "${save}" --fo4-effects player RESULT_VARIABLE r OUTPUT_VARIABLE o ERROR_VARIABLE e)
	if (NOT r EQUAL 0)
		message("  ${save}: not listed (${e})")  # saves this build cannot read are other tests' business
		continue()
	endif()
	string(REGEX MATCHALL "\n#[0-9]+ " lines "\n${o}")
	list(LENGTH lines before)
	string(REGEX MATCH "\n#([0-9]+) [^\n]*when removed: no stat changes" m "\n${o}")
	set(n "${CMAKE_MATCH_1}")  # (before if(MATCHES), which sets CMAKE_MATCH_n again)
	if (NOT m OR o MATCHES "does not read completely")
		continue()
	endif()
	get_filename_component(name "${save}" NAME_WE)
	set(out "${OUT}/${name}_fx.fos")
	file(REMOVE "${out}")
	execute_process(COMMAND "${CLI}" "${save}" --fo4-remove-effects "player:#${n}" -o "${out}" RESULT_VARIABLE r OUTPUT_VARIABLE o2 ERROR_VARIABLE e2)
	if (NOT r EQUAL 0 OR NOT o2 MATCHES "verified")
		message(FATAL_ERROR "${save}: removing #${n} failed (${r}): ${o2} ${e2}")
	endif()
	execute_process(COMMAND "${CLI}" "${out}" --fo4-effects player RESULT_VARIABLE r OUTPUT_VARIABLE o3)
	string(REGEX MATCHALL "\n#[0-9]+ " lines3 "\n${o3}")
	list(LENGTH lines3 after)
	math(EXPR want "${before} - 1")
	if (NOT r EQUAL 0 OR NOT after EQUAL want)
		message(FATAL_ERROR "${save}: the new save lists ${after} effects, expected ${want}")
	endif()
	message("  ${name}: removed #${n} (${before} -> ${after} effects)")
	math(EXPR done "${done} + 1")
endforeach()
if (done EQUAL 0)
	message(FATAL_ERROR "no save had an effect to remove")
endif()
